{
  "name": "ocr-ready",
  "version": "0.1.0",
  "description": "One-call pre-OCR quality gate for document and ID photos: checks blur, exposure, contrast, glare, shadow and skew, then returns pass/fail with reasons and retake hints.",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "bin": {
    "ocr-ready": "./dist/cli.js"
  },
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "CHANGELOG.md"
  ],
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "prepublishOnly": "npm run typecheck && npm run build && npm test"
  },
  "keywords": [
    "ocr",
    "ocr-preprocessing",
    "image-quality",
    "document-scanning",
    "kyc",
    "id-verification",
    "receipt",
    "blur-score",
    "exposure-score",
    "contrast-score",
    "glare-score",
    "shadow-score",
    "skew-score",
    "quality-gate",
    "sharp"
  ],
  "author": "Vijay Misal <misalvijay153@gmail.com>",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/vjymisal0/ocr-ready.git"
  },
  "bugs": {
    "url": "https://github.com/vjymisal0/ocr-ready/issues"
  },
  "homepage": "https://github.com/vjymisal0/ocr-ready#readme",
  "license": "MIT",
  "engines": {
    "node": ">=20.9.0"
  },
  "overrides": {
    "esbuild": "^0.28.2"
  },
  "sideEffects": false,
  "publishConfig": {
    "access": "public"
  },
  "dependencies": {
    "blur-score": "^1.0.8",
    "contrast-score": "^1.1.1",
    "exposure-score": "^1.0.6",
    "glare-score": "^1.1.1",
    "shadow-score": "^1.1.1",
    "skew-score": "^1.1.1"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "sharp": "^0.35.5",
    "tsup": "^8.5.1",
    "typescript": "~5.9.3",
    "vitest": "^5.0.5"
  }
}
